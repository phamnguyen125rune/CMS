# Server Configuration
SERVER_PORT=8080

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/CMS?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=root
DB_PASSWORD=your_db_password_here

# JWT Security Configuration
# A secure 512-bit (64-byte) Base64 encoded key for HS512 algorithm
JWT_SECRET=your_base64_secret_key_here
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=8640000
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=8640000

# Email Configuration (Gmail SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=ivs.cms.1@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=ivs.cms.1@gmail.com

# OTP Configuration
OTP_VALIDITY_MINUTES=5
OTP_RESEND_DELAY_SECONDS=60
OTP_RESET_TOKEN_VALIDITY_MINUTES=10

# Default Admin Seed Configuration
DEFAULT_ADMIN_EMAIL=admin@cms.local
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_ADMIN_PHONE=0900000000
