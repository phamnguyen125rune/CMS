# Server Configuration
SERVER_PORT=8080

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/CMS
DB_USERNAME=root
DB_PASSWORD=

# JWT Security Configuration
# A secure 512-bit (64-byte) Base64 encoded key for HS512 algorithm
JWT_SECRET=your_base64_secret_key_here
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=8640000
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=8640000

# Email Configuration (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# Default Admin Seed Configuration
DEFAULT_ADMIN_EMAIL=admin@cms.local
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_ADMIN_PHONE=0900000000
